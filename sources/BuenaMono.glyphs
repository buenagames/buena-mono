{
code = "# Lining Figures — complement to onum (lining is default)
sub zero.onum by zero;
sub one.onum by one;
sub two.onum by two;
sub three.onum by three;
sub four.onum by four;
sub five.onum by five;
sub six.onum by six;
sub seven.onum by seven;
sub eight.onum by eight;
sub nine.onum by nine;

# Identity mapping — lining figures are the default style
sub zero by zero;
sub one by one;
sub two by two;
sub three by three;
sub four by four;
sub five by five;
sub six by six;
sub seven by seven;
sub eight by eight;
sub nine by nine;
";
tag = lnum;
},
{
code = "# Alternate Annotation Forms — circled digits and letters

