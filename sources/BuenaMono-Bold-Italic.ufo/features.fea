} aalt;

feature locl {
script latn;
language TRK include_dflt;
sub i by uni0131;
language AZE include_dflt;
sub i by uni0131;
language CRT include_dflt;
sub i by uni0131;

} locl;

feature ccmp {
# Base soft-dotted characters
  sub i' lookup remove_dot @CombAbove;
  sub j' lookup remove_dot @CombAbove;
  sub uni0456' lookup remove_dot @CombAbove;
  sub uni0458' lookup remove_dot @CombAbove;
  # Precomposed soft-dotted characters
  sub uni012F' lookup decompose_soft_dotted @CombAbove;
  sub uni1ECB' lookup decompose_soft_dotted @CombAbove;
  sub uni0129' lookup decompose_soft_dotted @CombAbove;
  sub uni012B' lookup decompose_soft_dotted @CombAbove;
  sub uni012D' lookup decompose_soft_dotted @CombAbove;
  sub uni01D0' lookup decompose_soft_dotted @CombAbove;
  sub uni0135' lookup decompose_soft_dotted @CombAbove;
  sub uni01F0' lookup decompose_soft_dotted @CombAbove;
  sub uni0457' lookup decompose_soft_dotted @CombAbove;

} ccmp;

feature subs {
# Subscripts
sub zero by uni2080;
sub one by uni2081;
sub two by uni2082;
sub three by uni2083;
sub four by uni2084;
sub five by uni2085;
sub six by uni2086;
sub seven by uni2087;
sub eight by uni2088;
sub nine by uni2089;

} subs;

feature sups {
# Superscripts
sub zero by uni2070;
sub one by uni00B9;
sub two by uni00B2;
sub three by uni00B3;
sub four by uni2074;
sub five by uni2075;
sub six by uni2076;
sub seven by uni2077;
sub eight by uni2078;
sub nine by uni2079;

} sups;

feature numr {
# Numerators (superscript position for fraction building)
sub zero by uni2070;
sub one by uni00B9;
sub two by uni00B2;
sub three by uni00B3;
sub four by uni2074;
sub five by uni2075;
sub six by uni2076;
sub seven by uni2077;
sub eight by uni2078;
sub nine by uni2079;

} numr;

feature dnom {
# Denominators (subscript position for fraction building)
sub zero by uni2080;
sub one by uni2081;
sub two by uni2082;
sub three by uni2083;
sub four by uni2084;
sub five by uni2085;
sub six by uni2086;
sub seven by uni2087;
sub eight by uni2088;
sub nine by uni2089;

} dnom;

feature frac {
# Common fractions
sub one slash four by onequarter;
sub one slash two by onehalf;
sub three slash four by threequarters;
sub one slash three by uni2153;
sub two slash three by uni2154;
sub one slash eight by uni215B;
sub three slash eight by uni215C;
sub five slash eight by uni215D;
sub seven slash eight by uni215E;

} frac;

feature ordn {
# Ordinal indicators
sub a by ordfeminine;
sub o by ordmasculine;

} ordn;

feature case {
# Case-sensitive forms
sub parenleft by parenleft.case;
sub parenright by parenright.case;
sub bracketleft by bracketleft.case;
sub bracketright by bracketright.case;
sub braceleft by braceleft.case;
sub braceright by braceright.case;
sub hyphen by hyphen.case;

} case;

feature zero {
# Slashed Zero → Dotted Zero
sub zero by zero.ss11;

} zero;

feature onum {
# Oldstyle Figures
sub zero by zero.onum;
sub one by one.onum;
sub two by two.onum;
sub three by three.onum;
sub four by four.onum;
sub five by five.onum;
sub six by six.onum;
sub seven by seven.onum;
sub eight by eight.onum;
sub nine by nine.onum;

} onum;

feature ss01 {
# Stylistic Set 01: Single-storey a
sub a by a.ss01;

} ss01;

feature ss02 {
# Stylistic Set 02: Alternate f
sub f by f.ss02;

} ss02;

feature ss03 {
# Stylistic Set 03: Alternate l
sub l by l.ss03;

} ss03;

feature ss04 {
# Stylistic Set 04: Rounded dots
sub i by i.ss04;
sub j by j.ss04;

} ss04;

feature ss05 {
# Stylistic Set 05: Open tail g
sub g by g.ss05;

} ss05;

feature ss06 {
# Stylistic Set 06: Ear g
sub g by g.ss06;

} ss06;

feature ss07 {
# Stylistic Set 07: Tailed i
sub i by i.ss07;

} ss07;

feature ss08 {
# Stylistic Set 08: Straight y
sub y by y.ss08;

} ss08;

feature ss09 {
# Stylistic Set 09: Cursive y
sub y by y.ss09;

} ss09;

feature ss10 {
# Stylistic Set 10: Plain zero
sub zero by zero.ss10;

} ss10;

feature ss11 {
# Stylistic Set 11: Dotted zero
sub zero by zero.ss11;

} ss11;

feature ss12 {
# Stylistic Set 12: Alternate r
sub r by r.ss12;

} ss12;

feature cv01 {
cvParameters {
  FeatUILabelNameID { name "Single-storey a"; };
  FeatUITooltipTextNameID { name "Replace double-storey a with single-storey variant (Space Mono style)"; };
};
sub a by a.ss01;

} cv01;

feature cv02 {
cvParameters {
  FeatUILabelNameID { name "Alternate f"; };
  FeatUITooltipTextNameID { name "Replace f with IBM Plex Mono style variant"; };
};
sub f by f.ss02;

} cv02;

feature cv03 {
cvParameters {
  FeatUILabelNameID { name "Alternate l"; };
  FeatUITooltipTextNameID { name "Replace l with JetBrains Mono style variant"; };
};
sub l by l.ss03;

} cv03;

feature cv04 {
cvParameters {
  FeatUILabelNameID { name "Rounded dot i"; };
  FeatUITooltipTextNameID { name "Replace i with rounded dot variant"; };
};
sub i by i.ss04;

} cv04;

feature cv05 {
cvParameters {
  FeatUILabelNameID { name "Rounded dot j"; };
  FeatUITooltipTextNameID { name "Replace j with rounded dot variant"; };
};
sub j by j.ss04;

} cv05;

feature cv06 {
cvParameters {
  FeatUILabelNameID { name "Open tail g"; };
  FeatUITooltipTextNameID { name "Replace g with open tail variant (Space Mono style)"; };
};
sub g by g.ss05;

} cv06;

feature cv07 {
cvParameters {
  FeatUILabelNameID { name "Ear g"; };
  FeatUITooltipTextNameID { name "Replace g with ear variant (Ensba Mono style)"; };
};
sub g by g.ss06;

} cv07;

feature cv08 {
cvParameters {
  FeatUILabelNameID { name "Tailed i"; };
  FeatUITooltipTextNameID { name "Replace i with tailed variant (Ensba Mono style)"; };
};
sub i by i.ss07;

} cv08;

feature cv09 {
cvParameters {
  FeatUILabelNameID { name "Straight y"; };
  FeatUITooltipTextNameID { name "Replace y with straight descender (Space Mono style)"; };
};
sub y by y.ss08;

} cv09;

feature cv10 {
cvParameters {
  FeatUILabelNameID { name "Cursive y"; };
  FeatUITooltipTextNameID { name "Replace y with cursive variant (Sharp Earth Mono style)"; };
};
sub y by y.ss09;

} cv10;

feature cv11 {
cvParameters {
  FeatUILabelNameID { name "Plain zero"; };
  FeatUITooltipTextNameID { name "Replace slashed zero with plain zero (no slash or dot)"; };
};
sub zero by zero.ss10;

} cv11;

feature cv12 {
cvParameters {
  FeatUILabelNameID { name "Dotted zero"; };
  FeatUITooltipTextNameID { name "Replace slashed zero with dotted zero"; };
};
sub zero by zero.ss11;

} cv12;

feature cv13 {
cvParameters {
  FeatUILabelNameID { name "Alternate r"; };
  FeatUITooltipTextNameID { name "Replace r with iA Writer Mono style variant"; };
};
sub r by r.ss12;

} cv13;

feature sinf {
# Scientific Inferiors (subscript for chemistry: H₂O, CO₂)
sub zero by uni2080;
sub one by uni2081;
sub two by uni2082;
sub three by uni2083;
sub four by uni2084;
sub five by uni2085;
sub six by uni2086;
sub seven by uni2087;
sub eight by uni2088;
sub nine by uni2089;

} sinf;

feature tnum {
# Tabular Figures (all digits already monospaced at 618 width)
# No substitution needed — serves as a signal to applications
sub zero by zero;
sub one by one;
sub two by two;
sub three by three;
sub four by four;
sub five by five;
sub six by six;
sub seven by seven;
sub eight by eight;
sub nine by nine;

} tnum;

feature salt {
# Stylistic Alternates — single toggle for all ss/cv alternates
sub a from [a.ss01];
sub f from [f.ss02];
sub g from [g.ss05 g.ss06];
sub i from [i.ss04 i.ss07];
sub j from [j.ss04];
sub l from [l.ss03];
sub r from [r.ss12];
sub y from [y.ss08 y.ss09];
sub zero from [zero.ss10 zero.ss11];

} salt;

feature lnum {
# Lining Figures — complement to onum (lining is default)
sub zero.onum by zero;
sub one.onum by one;
sub two.onum by two;
sub three.onum by three;
sub four.onum by four;
sub five.onum by five;
sub six.onum by six;
sub seven.onum by seven;
sub eight.onum by eight;
sub nine.onum by nine;

# Identity mapping — lining figures are the default style
sub zero by zero;
sub one by one;
sub two by two;
sub three by three;
sub four by four;
sub five by five;
sub six by six;
sub seven by seven;
sub eight by eight;
sub nine by nine;

} lnum;

