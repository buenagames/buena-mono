# Prefix: Languagesystems
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn TRK;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem cyrl dflt;
languagesystem grek dflt;


# Prefix: CcmpLookups
# Soft-dotted: remove dot from i/j when followed by combining marks above
@CombAbove = [
              uni0300 uni0301 uni0302 uni0303 uni0304 uni0305 uni0306 uni0307
              uni0308 uni0309 uni030A uni030B uni030C uni030D uni030E uni030F
              uni0310 uni0311 uni0312 uni0313 uni0314 uni0315 uni033D uni033E
              uni033F uni0340 uni0341 uni0342 uni0343 uni0344 uni0346 uni034A
              uni034B uni034C uni0350 uni0351 uni0352 uni0357 uni035B uni0363
              uni0364 uni0365 uni0366 uni0367 uni0368 uni0369 uni036A uni036B
              uni036C uni036D uni036E uni036F uni0483 uni0484 uni0485 uni0486
              uni0487 uni1DC0 uni1DC1 uni1DC3 uni1DC4 uni1DC5 uni1DC6 uni1DC7
              uni1DC8 uni1DC9 uni1DCB uni1DCC uni1DD1 uni1DD2 uni1DD3 uni1DD4
              uni1DD5 uni1DD6 uni1DD7 uni1DD8 uni1DD9 uni1DDA uni1DDB uni1DDC
              uni1DDD uni1DDE uni1DDF uni1DE0 uni1DE1 uni1DE2 uni1DE3 uni1DE4
              uni1DE5 uni1DE6 uni1DE7 uni1DE8 uni1DE9 uni1DEA uni1DEB uni1DEC
              uni1DED uni1DEE uni1DEF uni1DF0 uni1DF1 uni1DF2 uni1DF3 uni1DF4
              uni1DF5 uni1DFB uni1DFE uni2DE0 uni2DE1 uni2DE2 uni2DE3 uni2DE4
              uni2DE5 uni2DE6 uni2DE7 uni2DE8 uni2DE9 uni2DEA uni2DEB uni2DEC
              uni2DED uni2DEE uni2DEF uni2DF0 uni2DF1 uni2DF2 uni2DF3 uni2DF4
              uni2DF5 uni2DF6 uni2DF7 uni2DF8 uni2DF9 uni2DFA uni2DFB uni2DFC
              uni2DFD uni2DFE uni2DFF uniA66F uniA674 uniA675 uniA676 uniA677
              uniA678 uniA679 uniA67A uniA67B uniA67C uniA67D uniA69E uniA69F];

lookup remove_dot {
  sub i by uni0131;
  sub j by uni0237;
  sub uni0456 by uni0131;
  sub uni0458 by uni0237;
} remove_dot;

lookup decompose_soft_dotted {
  # Precomposed i-based: decompose to dotlessi + combining mark(s)
  sub uni012F by uni0131 uni0328;  # į → dotlessi + ogonek
  sub uni1ECB by uni0131 uni0323;  # ị → dotlessi + dot below
  sub uni0129 by uni0131 uni0303;  # ĩ → dotlessi + tilde
  sub uni012B by uni0131 uni0304;  # ī → dotlessi + macron
  sub uni012D by uni0131 uni0306;  # ĭ → dotlessi + breve
  sub uni01D0 by uni0131 uni030C;  # ǐ → dotlessi + caron
  # Precomposed j-based
  sub uni0135 by uni0237 uni0302;  # ĵ → dotlessj + circumflex
  sub uni01F0 by uni0237 uni030C;  # ǰ → dotlessj + caron
  # Cyrillic і-based
  sub uni0457 by uni0131 uni0308;  # ї → dotlessi + diaeresis
} decompose_soft_dotted;


feature liga {
# Standard ligatures (linguistic)
# Order: longer sequences first
sub f f i by f_f_i.liga;
sub f f l by f_f_l.liga;
sub f f by f_f.liga;
sub f i by f_i.liga;
sub f l by f_l.liga;

} liga;

feature calt {
# Coding ligatures (calt — on by default)
# Order: longer sequences first to ensure correct matching

# 4-char sequences
sub less exclam hyphen hyphen by less_exclam_hyphen_hyphen.liga;
sub less equal equal greater by less_equal_equal_greater.liga;
sub braceleft braceleft hyphen hyphen by braceleft_braceleft_hyphen_hyphen.liga;
sub hyphen hyphen braceright braceright by hyphen_hyphen_braceright_braceright.liga;
sub braceleft exclam hyphen hyphen by braceleft_exclam_hyphen_hyphen.liga;

# Phase 5 — 4-char
sub bar bar bar greater by bar_bar_bar_greater.liga;
sub less bar bar bar by less_bar_bar_bar.liga;

# 3-char sequences
sub hyphen hyphen greater by hyphen_hyphen_greater.liga;
sub period period period by period_period_period.liga;
sub exclam equal equal by exclam_equal_equal.liga;
sub equal equal equal by equal_equal_equal.liga;
sub less hyphen hyphen by less_hyphen_hyphen.liga;
sub less hyphen greater by less_hyphen_greater.liga;
sub equal equal greater by equal_equal_greater.liga;
sub less equal equal by less_equal_equal.liga;
sub hyphen greater greater by hyphen_greater_greater.liga;
sub equal greater greater by equal_greater_greater.liga;
sub hyphen less less by hyphen_less_less.liga;
sub bar bar equal by bar_bar_equal.liga;
sub bar bar greater by bar_bar_greater.liga;
sub less bar bar by less_bar_bar.liga;
sub less bar greater by less_bar_greater.liga;
sub slash slash slash by slash_slash_slash.liga;
sub slash slash equal by slash_slash_equal.liga;
sub slash asterisk asterisk by slash_asterisk_asterisk.liga;
sub slash equal equal by slash_equal_equal.liga;
sub asciitilde asciitilde greater by asciitilde_asciitilde_greater.liga;
sub less asciitilde asciitilde by less_asciitilde_asciitilde.liga;
sub less asciitilde greater by less_asciitilde_greater.liga;
sub equal colon equal by equal_colon_equal.liga;
sub question question question by question_question_question.liga;
# Phase 2 — 3-char
sub numbersign numbersign numbersign numbersign by numbersign_numbersign_numbersign_numbersign.liga;
sub numbersign numbersign numbersign by numbersign_numbersign_numbersign.liga;
sub numbersign underscore parenleft by numbersign_underscore_parenleft.liga;
sub bar hyphen greater by bar_hyphen_greater.liga;
sub bar equal greater by bar_equal_greater.liga;
sub greater hyphen greater by greater_hyphen_greater.liga;
sub greater equal greater by greater_equal_greater.liga;
sub greater greater hyphen by greater_greater_hyphen.liga;
sub greater greater greater by greater_greater_greater.liga;
sub less hyphen less by less_hyphen_less.liga;
sub less hyphen bar by less_hyphen_bar.liga;
sub less equal less by less_equal_less.liga;
sub less equal bar by less_equal_bar.liga;
sub equal less less by equal_less_less.liga;
sub plus plus plus by plus_plus_plus.liga;
sub less plus greater by less_plus_greater.liga;
sub asterisk asterisk asterisk by asterisk_asterisk_asterisk.liga;
sub less asterisk greater by less_asterisk_greater.liga;
sub less less asciitilde by less_less_asciitilde.liga;
# Phase 3 — 3-char
sub semicolon semicolon semicolon by semicolon_semicolon_semicolon.liga;
sub less less less by less_less_less.liga;
sub less colon less by less_colon_less.liga;
sub hyphen hyphen hyphen by hyphen_hyphen_hyphen.liga;
sub less slash greater by less_slash_greater.liga;
sub braceleft exclam exclam by braceleft_exclam_exclam.liga;
sub exclam exclam braceright by exclam_exclam_braceright.liga;
sub ampersand ampersand ampersand by ampersand_ampersand_ampersand.liga;
# Phase 4 — dlig migrated to calt (3-char)
sub less equal greater by less_equal_greater.liga;
sub colon colon equal by colon_colon_equal.liga;
sub greater greater equal by greater_greater_equal.liga;
sub less less equal by less_less_equal.liga;
sub equal exclam equal by equal_exclam_equal.liga;

# Phase 5 — 3-char
sub w w w by w_w_w.liga;
sub colon colon colon by colon_colon_colon.liga;
sub equal slash equal by equal_slash_equal.liga;
sub less dollar greater by less_dollar_greater.liga;
sub less less hyphen by less_less_hyphen.liga;
sub exclam exclam period by exclam_exclam_period.liga;
sub period period equal by period_period_equal.liga;
sub period period less by period_period_less.liga;

# Phase 6 — 3-char
sub question question equal by question_question_equal.liga;
sub numbersign exclam bracketleft by numbersign_exclam_bracketleft.liga;
sub colon slash slash by colon_slash_slash.liga;

# 2-char sequences
sub hyphen greater by hyphen_greater.liga;
sub equal greater by equal_greater.liga;
sub less hyphen by less_hyphen.liga;
sub less equal by less_equal.liga;
sub greater equal by greater_equal.liga;
sub equal equal by equal_equal.liga;
sub exclam equal by exclam_equal.liga;
sub colon colon by colon_colon.liga;
sub period period by period_period.liga;
sub question question by question_question.liga;
sub question colon by question_colon.liga;
sub bar greater by bar_greater.liga;
sub less bar by less_bar.liga;
sub greater greater by greater_greater.liga;
sub less less by less_less.liga;
sub slash asterisk by slash_asterisk.liga;
sub asterisk slash by asterisk_slash.liga;
sub slash slash by slash_slash.liga;
sub less slash by less_slash.liga;
sub slash greater by slash_greater.liga;
sub less greater by less_greater.liga;
# Phase 1 — 2-char
sub hyphen less by hyphen_less.liga;
sub bar equal by bar_equal.liga;
sub bar hyphen by bar_hyphen.liga;
sub hyphen bar by hyphen_bar.liga;
sub slash equal by slash_equal.liga;
sub asciitilde greater by asciitilde_greater.liga;
sub less asciitilde by less_asciitilde.liga;
sub asciitilde hyphen by asciitilde_hyphen.liga;
sub colon equal by colon_equal.liga;
sub equal colon by equal_colon.liga;
sub question equal by question_equal.liga;
sub question period by question_period.liga;
# Phase 2 — 2-char
sub numbersign numbersign by numbersign_numbersign.liga;
sub numbersign equal by numbersign_equal.liga;
sub numbersign exclam by numbersign_exclam.liga;
sub numbersign colon by numbersign_colon.liga;
sub numbersign question by numbersign_question.liga;
sub numbersign braceleft by numbersign_braceleft.liga;
sub numbersign bracketleft by numbersign_bracketleft.liga;
sub numbersign parenleft by numbersign_parenleft.liga;
sub numbersign underscore by numbersign_underscore.liga;
sub bracketright numbersign by bracketright_numbersign.liga;
sub greater hyphen by greater_hyphen.liga;
sub plus greater by plus_greater.liga;
sub less plus by less_plus.liga;
sub asterisk greater by asterisk_greater.liga;
sub less asterisk by less_asterisk.liga;
sub dollar greater by dollar_greater.liga;
sub less dollar by less_dollar.liga;
sub hyphen asciitilde by hyphen_asciitilde.liga;
sub asciitilde at by asciitilde_at.liga;
# Phase 3 — 2-char
sub bracketleft bar by bracketleft_bar.liga;
sub bar bracketright by bar_bracketright.liga;
sub braceleft bar by braceleft_bar.liga;
sub bar braceright by bar_braceright.liga;
sub braceleft braceleft by braceleft_braceleft.liga;
sub braceright braceright by braceright_braceright.liga;
sub ampersand equal by ampersand_equal.liga;
sub semicolon semicolon by semicolon_semicolon.liga;
sub exclam exclam by exclam_exclam.liga;
sub greater colon by greater_colon.liga;
sub colon less by colon_less.liga;
sub colon greater by colon_greater.liga;
sub less colon by less_colon.liga;
# Phase 4 — dlig migrated to calt (2-char)
sub ampersand ampersand by ampersand_ampersand.liga;
sub bar bar by bar_bar.liga;
sub plus plus by plus_plus.liga;
sub hyphen hyphen by hyphen_hyphen.liga;
sub asterisk asterisk by asterisk_asterisk.liga;
sub asciitilde asciitilde by asciitilde_asciitilde.liga;
# Phase 5 — 2-char
sub underscore underscore by underscore_underscore.liga;
sub asciicircum equal by asciicircum_equal.liga;
sub asciitilde equal by asciitilde_equal.liga;
sub period equal by period_equal.liga;
# Phase 6 — 2-char
sub asterisk equal by asterisk_equal.liga;
sub plus equal by plus_equal.liga;
sub hyphen equal by hyphen_equal.liga;
sub slash backslash by slash_backslash.liga;
sub backslash slash by backslash_slash.liga;
sub percent percent by percent_percent.liga;
sub parenleft asterisk by parenleft_asterisk.liga;
sub asterisk parenright by asterisk_parenright.liga;
sub backslash backslash by backslash_backslash.liga;
sub at underscore by at_underscore.liga;

} calt;

feature dlig {
# Discretionary ligatures (off by default)
# 3-char sequences first (longer match priority)
sub less equal greater by less_equal_greater.liga;
sub colon colon equal by colon_colon_equal.liga;
sub greater greater equal by greater_greater_equal.liga;
sub less less equal by less_less_equal.liga;
sub equal exclam equal by equal_exclam_equal.liga;
# 2-char sequences
sub ampersand ampersand by ampersand_ampersand.liga;
sub bar bar by bar_bar.liga;
sub plus plus by plus_plus.liga;
sub hyphen hyphen by hyphen_hyphen.liga;
sub asterisk asterisk by asterisk_asterisk.liga;
sub asciitilde asciitilde by asciitilde_asciitilde.liga;

} dlig;

